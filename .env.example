# PixelForge Environment Variables

# ============================================
# REQUIRED
# ============================================

# Replicate API Token (for AI image generation)
# Get yours at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NFT.Storage API Token (for IPFS uploads)
# Get yours at: https://nft.storage/manage
NEXT_PUBLIC_NFT_STORAGE_TOKEN=eyJhbGxxxxxxxxxxxxxxxxxxxxxxxxx

# WalletConnect Project ID (for wallet modal)
# Get yours at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL
# ============================================

# Base Mainnet RPC (optional, defaults to public RPC)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Zora API Key (optional, for enhanced Zora features)
NEXT_PUBLIC_ZORA_API_KEY=

# App URL (set in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
